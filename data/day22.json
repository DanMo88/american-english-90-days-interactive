},
{
"p": 0,
"t": "Her face is white.",
"s": 6.78
},
{
"p": 0,
"t": "“Sam, Max is gone! The gate in the backyard is open.”",
"s": 8.43
},
{
"p": 1,
"t": "We look everywhere: under the cars, behind the trees, and in the park.",
"s": 12.7
},
{
"p": 1,
"t": "No Max.",
"s": 16.83
},
{
"p": 2,
"t": "“Let’s make posters,” I say.",
"s": 18.43
},
{
"p": 2,
"t": "My poster has a big photo of Max.",
"s": 20.41
},
{
"p": 2,
"t": "It says: “LOST DOG! Max. Brown, red collar, very friendly. He likes chasing squirrels and eating hot dogs. Please call 555-274-8190.”",
"s": 22.43
},
{
"p": 3,
"t": "We put the posters on trees and in shop windows.",
"s": 36.19
},
{
"p": 3,
"t": "Emma puts the photo online.",
"s": 39.47
},
{
"p": 4,
"t": "We walk and call his name for three hours.",
"s": 41.99
},
{
"p": 4,
"t": "Rosa is very worried.",
"s": 44.76
},
{
"p": 4,
"t": "“He is old, Sam. He doesn’t know the streets.”",
"s": 46.6
},
{
"p": 5,
"t": "At seven o’clock, my phone rings.",
"s": 49.96
},
{
"p": 5,
"t": "“Hi, is this Sam? I think I have your dog. He is in my yard, and he is eating my hamburger!” It is a man on Elm Street.",
"s": 52.52
},
{
"p": 6,
"t": "We run to Elm Street.",
"s": 60.95
},
{
"p": 6,
"t": "Max is there, with ketchup on his nose.",
"s": 62.63
},
{
"p": 6,
"t": "He jumps on Rosa, and she laughs and cries at the same time.",
"s": 65.44
},
{
"p": 7,
"t": "“No more hamburgers for you!” she tells Max.",
"s": 69.81
}
