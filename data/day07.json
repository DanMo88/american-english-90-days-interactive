},
{
"p": 5,
"t": "“Hmm, I’m busy on Thursday afternoon. Can you come on Friday morning?”",
"s": 34.84
},
{
"p": 6,
"t": "“Yes! Friday morning is perfect.”",
"s": 39.82
},
{
"p": 7,
"t": "I write “INTERVIEW” on my calendar for Friday.",
"s": 42.74
},
{
"p": 7,
"t": "Now I am nervous.",
